{
  "name": "ranch",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "evals"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && npm -w apps/web run typecheck",
    "test": "node --test --experimental-strip-types 'packages/*/test/*.test.ts' 'apps/*/test/*.test.ts' && npm -w apps/web test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check \"**/*.{ts,tsx,js,mjs,css}\"",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,mjs,css}\"",
    "docs:check": "node .claude/skills/writing-docs/scripts/check-doc.mjs docs/*.md",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.3.0",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.72.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": "prettier --write",
    "docs/**/*.md": "node .claude/skills/writing-docs/scripts/check-doc.mjs"
  },
  "overrides": {
    "eslint": "$eslint"
  }
}
