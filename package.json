{
  "name": "ranch",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "evals"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types 'packages/*/test/*.test.ts' 'apps/*/test/*.test.ts'"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
