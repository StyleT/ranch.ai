      "version": "0.0.1",
      "dependencies": {
        "@ranch/bus": "*",
        "@ranch/config": "*",
        "@ranch/events": "*",
        "sharp": "^0.34.3"
      }
    },
    "apps/netprobe": {
      "name": "@ranch/netprobe",
      "version": "0.0.1",
      "dependencies": {
        "@ranch/bus": "*",
        "@ranch/config": "*"
      }
    },
