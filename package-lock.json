{
  "name": "ranch",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "ranch",
      "workspaces": [
        "packages/*",
        "apps/*",
        "evals"
      ],
      "devDependencies": {
        "@types/node": "^24.3.0",
        "typescript": "^5.9.2"
      },
      "engines": {
        "node": ">=24"
      }
    },
    "apps/cli": {
      "name": "@ranch/cli",
      "version": "0.0.1",
      "dependencies": {
        "@ranch/config": "*",
        "@ranch/events": "*"
      },
      "bin": {
        "ranch": "src/main.ts"
      }
    },
    "apps/detector": {
      "name": "@ranch/detector",
      "version": "0.0.1",
      "dependencies": {
        "@ranch/bus": "*",
        "@ranch/config": "*",
        "@ranch/events": "*",
        "@ranch/taxonomy": "*"
      }
    },
    "apps/ingest": {
