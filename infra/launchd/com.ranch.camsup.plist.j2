<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ranch.camsup</string>
  <!-- The camera supervisor (apps/camsup, docs/CAMERA-ARCHITECTURE.md): remediation ladder over netprobe's facts.
       Reads only; acts through the bridge's MQTT power command (camera reboot via the Wyze cloud) and launchctl. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>exec '{{ ranch_bin_dir }}/node' '--no-warnings=ExperimentalWarning' '{{ ranch_app_dir }}/apps/camsup/src/main.ts' 2&gt;&amp;1 | exec /usr/bin/logger -t ranch.camsup -p user.notice</string>
  </array>
  <key>UserName</key><string>{{ ranch_user }}</string>
  <key>WorkingDirectory</key><string>{{ ranch_app_dir }}</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/{{ ranch_user }}</string>
    <key>PATH</key><string>{{ ranch_bin_dir }}:{{ brew_prefix }}/bin:/usr/bin:/bin:/sbin</string>
    <key>RANCH_MQTT_URL</key><string>mqtt://{{ mosquitto_listen }}:{{ mosquitto_port }}</string>
    <key>RANCH_DB</key><string>{{ ranch_var_dir }}/ranch-events.sqlite</string>
    <key>RANCH_LIVE</key><string>{{ ranch_media_dir }}/live</string>
    <key>RANCH_CAMERAS_EXCLUDE</key><string>living_room_cam</string>
    <key>RANCH_WB_TOPIC</key><string>wyzebridge</string>
    <key>RANCH_CAMSUP_DRY_RUN</key><string>{{ '1' if camsup_dry_run else '0' }}</string>
    <key>RANCH_CAMSUP_REBOOT_AFTER_S</key><string>{{ camsup_reboot_after_s }}</string>
    <key>RANCH_CAMSUP_REBOOT_COOLDOWN_S</key><string>{{ camsup_reboot_cooldown_s }}</string>
    <key>RANCH_CAMSUP_FLEET_REBOOTS_PER_H</key><string>{{ camsup_fleet_reboots_per_h }}</string>
    <key>RANCH_CAMSUP_GO2RTC_RESTART_AFTER_S</key><string>{{ camsup_go2rtc_restart_after_s }}</string>
    <key>RANCH_CAMSUP_GO2RTC_MIN_CAMERAS</key><string>{{ camsup_go2rtc_min_cameras }}</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>15</integer>
</dict>
</plist>
