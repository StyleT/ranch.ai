<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ranch.seed-recorder</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>exec '/bin/bash' '{{ ranch_bin_dir }}/seed-recorder.sh' 2&gt;&amp;1 | exec /usr/bin/logger -t ranch.seed-recorder -p user.notice</string>
  </array>
  <key>UserName</key><string>{{ ranch_user }}</string>
  <key>WorkingDirectory</key><string>{{ ranch_media_dir }}</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>{{ brew_prefix }}/bin:/usr/bin:/bin</string>
    <key>SEED_CAMERAS</key><string>{{ seed_cameras | join(' ') }}</string>
    <key>SEED_DIR</key><string>{{ ranch_media_dir }}/seed</string>
    <key>SEED_INTERVAL</key><string>{{ seed_interval_s }}</string>
    <key>SEED_JPEG_Q</key><string>{{ seed_jpeg_q }}</string>
    <key>SEED_MIN_FREE_GB</key><string>{{ seed_min_free_gb }}</string>
    <key>SEED_START_EPOCH</key><string>{{ seed_start_epoch }}</string>
    <key>SEED_HOURS</key><string>{{ seed_hours }}</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
</dict>
</plist>
