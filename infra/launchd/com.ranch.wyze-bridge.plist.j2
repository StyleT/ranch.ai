<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ranch.wyze-bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>exec '/bin/bash' '{{ ranch_bin_dir }}/wyze-bridge.sh' 2&gt;&amp;1 | exec /usr/bin/logger -t ranch.wyze-bridge -p user.notice</string>
  </array>
  <key>UserName</key><string>{{ ranch_user }}</string>
  <key>WorkingDirectory</key><string>{{ ranch_var_dir }}/wyze-bridge</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/{{ ranch_user }}</string>
    <key>PATH</key><string>{{ ranch_bin_dir }}:{{ brew_prefix }}/bin:/usr/bin:/bin</string>
    <key>STATE_DIR</key><string>{{ ranch_var_dir }}/wyze-bridge</string>
    <key>GO2RTC_URL</key><string>http://127.0.0.1:{{ go2rtc_api_port }}</string>
    <key>SNAPSHOT_PATH</key><string>{{ ranch_media_dir }}/snapshots/{cam_name}/%Y-%m-%d</string>
    <key>RECORD_PATH</key><string>{{ ranch_media_dir }}/recordings/{cam_name}/%Y/%m/%d</string>
    <key>MQTT_HOST</key><string>{{ mosquitto_listen }}</string>
    <key>MQTT_PORT</key><string>{{ mosquitto_port }}</string>
    <key>MQTT_TOPIC</key><string>wyzebridge</string>
    <key>LOG_LEVEL</key><string>info</string>
    <!-- 23 Oct: the bridge's TUTK->WebRTC auto-promotion is off. Wyze's cloud answers "camera does not use WebRTC
         streaming" for this fleet, so a promotion would swap TUTK for a 404; and the bridge's health check cannot see a
         dead TUTK producer anyway (it counts a configured source as alive). Camera health is the supervisor's job
         (docs/CAMERA-ARCHITECTURE.md). -->
    <key>TUTK_FALLBACK_THRESHOLD</key><string>0</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>15</integer>
</dict>
</plist>
