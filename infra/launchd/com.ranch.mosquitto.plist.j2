<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ranch.mosquitto</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>exec '{{ brew_prefix }}/opt/mosquitto/sbin/mosquitto' '-c' '{{ brew_prefix }}/etc/mosquitto/mosquitto.conf' 2&gt;&amp;1 | exec /usr/bin/logger -t ranch.mosquitto -p user.notice</string>
  </array>
  <key>UserName</key><string>{{ ranch_user }}</string>
  <key>WorkingDirectory</key><string>{{ ranch_var_dir }}/mosquitto</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
</dict>
</plist>
