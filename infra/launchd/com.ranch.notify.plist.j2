<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ranch.notify</string>
  <!-- Notifications that reach a person (apps/notify, docs/CAMERA-ARCHITECTURE.md, 1 Nov): fleet-down, a camera down
       for an hour, the supervisor's actions, and a daily online line, posted to an ntfy.sh topic whose name lives in
       ~/.config/ranch/notify.env on the mini (mode 600, never in the repo). Without that file it only logs. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>exec '{{ ranch_bin_dir }}/node' '--no-warnings=ExperimentalWarning' '{{ ranch_app_dir }}/apps/notify/src/main.ts' 2&gt;&amp;1 | exec /usr/bin/logger -t ranch.notify -p user.notice</string>
  </array>
  <key>UserName</key><string>{{ ranch_user }}</string>
  <key>WorkingDirectory</key><string>{{ ranch_app_dir }}</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/{{ ranch_user }}</string>
    <key>PATH</key><string>{{ ranch_bin_dir }}:{{ brew_prefix }}/bin:/usr/bin:/bin</string>
    <key>RANCH_MQTT_URL</key><string>mqtt://{{ mosquitto_listen }}:{{ mosquitto_port }}</string>
    <key>RANCH_DB</key><string>{{ ranch_var_dir }}/ranch-events.sqlite</string>
    <key>RANCH_CAMERAS_EXCLUDE</key><string>living_room_cam</string>
    <key>RANCH_NOTIFY_ENV</key><string>/Users/{{ ranch_user }}/.config/ranch/notify.env</string>
    <key>RANCH_NOTIFY_FLEET_MIN</key><string>{{ notify_fleet_min }}</string>
    <key>RANCH_NOTIFY_FLEET_AFTER_S</key><string>{{ notify_fleet_after_s }}</string>
    <key>RANCH_NOTIFY_CAMERA_AFTER_S</key><string>{{ notify_camera_after_s }}</string>
    <key>RANCH_NOTIFY_DAILY_UTC_HOUR</key><string>{{ notify_daily_utc_hour }}</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>15</integer>
</dict>
</plist>
