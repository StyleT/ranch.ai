<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ranch.status</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>exec '{{ ranch_bin_dir }}/node' '--no-warnings=ExperimentalWarning' '--max-old-space-size=64' '{{ ranch_app_dir }}/apps/status/src/main.ts' 2&gt;&amp;1 | exec /usr/bin/logger -t ranch.status -p user.notice</string>
  </array>
  <key>UserName</key><string>{{ ranch_user }}</string>
  <key>WorkingDirectory</key><string>{{ ranch_app_dir }}</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/{{ ranch_user }}</string>
    <key>PATH</key><string>{{ ranch_bin_dir }}:{{ brew_prefix }}/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>RANCH_DB</key><string>{{ ranch_var_dir }}/ranch-events.sqlite</string>
    <key>RANCH_MEDIA</key><string>{{ ranch_media_dir }}</string>
    <key>RANCH_LIVE</key><string>{{ ranch_media_dir }}/live</string>
    <key>RANCH_MQTT_URL</key><string>mqtt://{{ mosquitto_listen }}:{{ mosquitto_port }}</string>
    <key>RANCH_CAMERAS_EXCLUDE</key><string>living_room_cam</string>
    <key>RANCH_STATUS_PORT</key><string>{{ status_port }}</string>
    <key>RANCH_STATUS_HOST</key><string>{{ status_host }}</string>
    <key>RANCH_APP_DIR</key><string>{{ ranch_app_dir }}</string>
    <key>RANCH_REFERENCE_FRAMES</key><string>{{ status_reference_frames }}</string>
    <key>RANCH_REFERENCE_LABELS</key><string>{{ status_reference_labels }}</string>
    <key>RANCH_STATUS_ENV</key><string>/Users/{{ ranch_user }}/.config/ranch/status.env</string>
    <key>RANCH_TZ</key><string>{{ timezone }}</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>15</integer>
</dict>
</plist>
