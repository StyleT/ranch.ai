<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ranch.pf</string>
  <!-- One-shot at boot: enable the packet filter and load /etc/pf.conf (which loads the com.ranch anchor). -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>exec /sbin/pfctl -E -f /etc/pf.conf 2&gt;&amp;1 | exec /usr/bin/logger -t ranch.pf -p user.notice</string>
  </array>
  <key>RunAtLoad</key><true/>
</dict>
</plist>
