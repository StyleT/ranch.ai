# Managed by Ansible (infra/go2rtc/go2rtc.yaml.j2). go2rtc runs as com.ranch.go2rtc under launchd (KeepAlive,
# stderr captured in /var/log/ranch-go2rtc.log); the Wyze bridge talks to it over the API (GO2RTC_URL) and
# registers one wyze:// stream per camera at runtime, so there is no streams: section here.
log:
  level: info
  streams: debug      # producer connect/disconnect, keyframe waits: the evidence for camera dropouts
  api: {{ go2rtc_api_log }}   # trace while measuring which API paths the bridge calls (for api.allow_paths; requests log only at trace), warn otherwise
  rtsp: info
  webrtc: warn
# Loopback only (23 Oct): go2rtc dials a camera whenever a consumer attaches, so any LAN or tailnet device that could
# reach these ports could make it dial. Only processes on the mini may talk to go2rtc; the recorder is the single
# stream consumer (docs/CAMERA-ARCHITECTURE.md). pf refuses the same ports off-lo0 as the belt (loopback_only_ports).
api:
  listen: 127.0.0.1:{{ go2rtc_api_port }}
  origin: '*'
rtsp:
  listen: 127.0.0.1:8554
webrtc:
  # The browser consumes the camera over WebRTC (sub-second, native H.264, no transcode). Signalling is proxied by the
  # web app to go2rtc on loopback; the media port is reachable on the tailnet only (tailscale_only_ports) and go2rtc
  # advertises the mini's tailnet addresses as host candidates so the browser connects directly. A WebRTC consumer
  # shares the producer the recorder already holds, so it never re-dials the camera.
  listen: :8889
  candidates:
    - "{{ go2rtc_webrtc_candidate }}"
  ice_servers: []
  filters:
    candidates: []   # advertise ONLY the explicit tailnet candidate above, not the LAN/auto-discovered interface IPs
ffmpeg:
  bin: {{ brew_prefix }}/bin/ffmpeg
{% if go2rtc_preload_cameras %}
# Preload (go2rtc >= 1.9.11): go2rtc itself holds these cameras' sessions with no external consumer, so a recorder
# restart is no longer a camera redial and the dial cadence lives in one place. 23 Oct trial on one camera, measured
# for a day (producer starts per hour, availability) before the fleet (docs/CAMERA-ARCHITECTURE.md).
preload:
{% for cam in go2rtc_preload_cameras %}
  {{ cam }}: "video&audio"
{% endfor %}
{% endif %}
