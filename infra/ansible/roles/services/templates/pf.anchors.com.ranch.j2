# Managed by Ansible (roles/services, docs/WEB-DASHBOARD.md, docs/CAMERA-ARCHITECTURE.md).
# "return" = immediate connection refused instead of a silent drop. Rules are "quick": first match wins, so the pass
# rules come before the block rules.
#
# 1. Tailnet-only services (tailscale_only_ports): accepted only from Tailscale clients (CGNAT 100.64.0.0/10 and the
#    tailnet ULA fd7a:115c:a1e0::/48) addressed to this node's tailnet addresses; refused on every other interface,
#    the ranch LAN included. Loopback stays open for ssh -L and local health checks. (23 Oct: the dashboard moved from
#    LAN-only to tailnet-only; the tailnet is the authenticated network, the Wi-Fi is shared with the cameras.)
{% for port in tailscale_only_ports %}
{% for addr in tailscale_addrs %}
{% if ':' in addr %}
pass in quick inet6 proto tcp from fd7a:115c:a1e0::/48 to {{ addr }} port {{ port }}
{% else %}
pass in quick inet proto tcp from 100.64.0.0/10 to {{ addr }} port {{ port }}
{% endif %}
{% endfor %}
block return in quick on ! lo0 inet proto tcp from any to any port {{ port }}
block return in quick on ! lo0 inet6 proto tcp from any to any port {{ port }}
{% endfor %}
#
# 2. Loopback-only services (loopback_only_ports): refused on every interface except lo0, LAN and tailnet alike.
#    Anything that can attach a go2rtc consumer makes go2rtc dial a camera; only processes on the mini may do that.
{% for port in loopback_only_ports %}
block return in quick on ! lo0 inet proto tcp from any to any port {{ port }}
block return in quick on ! lo0 inet6 proto tcp from any to any port {{ port }}
{% endfor %}
#
# 3. Fault injection (make e2e-chaos, infra/bin/e2e-chaos.sh) loads temporary rules into the child anchor com.ranch/chaos.
#    A child anchor is only evaluated when the parent names it, so this line is what makes a chaos rule take effect;
#    the anchor is empty outside a test run.
anchor "chaos"
